rules_version = '2';
// FYP / development rules — most collections still use broad signed-in access.
// Companies with active status are readable without auth for field-user invite validation.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      // Use getAfter to allow rules to see the document being created in the same transaction
      // or use exists check to avoid crashing if the doc is missing.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentRole() {
      let user = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return (user != null && 'role' in user.data)
        ? user.data.role.lower().replace('_', '').replace(' ', '')
        : 'guest';
    }

    function isAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && exists(userPath)
        && currentRole() in ['admin', 'administrator'];
    }

    function isCeo() {
      return signedIn() && currentRole() == 'ceo';
    }

    function normalizedRole(role) {
      return role is string
        ? role.lower().replace('_', '').replace(' ', '')
        : '';
    }

    // CEO may only touch status lifecycle fields on field users in their company.
    function ceoFieldUserStatusKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'approved', 'approvedAt', 'rejectionReason']);
    }

    function ceoUpdatingOwnCompanyFieldUser() {
      let ceo = currentUser();
      let target = resource.data;
      let after = request.resource.data;
      return isCeo()
        && 'companyId' in ceo
        && ceo.companyId is string
        && ceo.companyId.size() > 0
        && 'companyId' in target
        && target.companyId == ceo.companyId
        && 'role' in target
        && normalizedRole(target.role) == 'fielduser'
        && (!('uid' in target) || after.uid == target.uid)
        && after.role == target.role
        && after.companyId == target.companyId
        && ceoFieldUserStatusKeysOnly();
    }

    function isValidAuditLog() {
      let d = request.resource.data;
      return d.actorId == request.auth.uid
        && d.actorId is string
        && d.actorId.size() > 0
        && d.actorId.size() <= 128
        && d.actorName is string
        && d.actorName.size() > 0
        && d.actorName.size() <= 200
        && d.actionType is string
        && d.actionType.size() > 0
        && d.actionType.size() <= 80
        && d.targetType is string
        && d.targetType.size() > 0
        && d.targetType.size() <= 40
        && d.targetId is string
        && d.targetId.size() > 0
        && d.targetId.size() <= 200
        && d.description is string
        && d.description.size() > 0
        && d.description.size() <= 1000
        && d.timestamp is timestamp
        && (!('reason' in d) || d.reason == null || (d.reason is string && d.reason.size() <= 4000));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          // Allow self-updates even if some fields aren't initialized yet
          && (!('uid' in resource.data) || request.resource.data.uid == resource.data.uid)
          && (!('role' in resource.data) || request.resource.data.role == resource.data.role)
          && (!('companyId' in resource.data) || request.resource.data.companyId == resource.data.companyId)
        )
        || ceoUpdatingOwnCompanyFieldUser();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin()
        || (signedIn() && 'ceoUid' in resource.data && resource.data.ceoUid == request.auth.uid)
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fieldUserCount', 'updatedAt']));
      allow delete: if isAdmin();
    }

    // Explicitly allow reading/writing to company subcollections if signed in.
    // Nested orders are handled by the dedicated /orders rules + collection-group
    // style path below — keep other company subcollections open for signed-in users.
    match /companies/{companyId}/{subcollection}/{document=**} {
      allow read, write: if signedIn() && subcollection != 'orders';
    }

    match /rfqs/{rfqId} {
      allow read: if signedIn();
      allow create, update, delete: if false;

      match /bids/{bidId} {
        allow read: if signedIn();
        allow create, update, delete: if false;
      }
    }

    match /disputes/{disputeId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && 'companyId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
          && resource.data.companyId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
        )
        || (
          signedIn()
          && resource.data.raisedByUid == request.auth.uid
        );
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'status',
            'resolutionNotes',
            'resolvedAt',
            'resolvedBy',
            'resolvedByUid',
            'updatedAt'
          ]);
      allow create, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidAuditLog();
      allow update, delete: if false;
    }

    match /appeals/{appealId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /rfq_jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /rfq_bid_jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /rfq_award_jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /rfq_cancel_jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /rfq_bid_withdraw_jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /dispute_jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /dispute_update_jobs/{jobId} {
      allow create: if isAdmin()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /dispute_withdraw_jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /commission_ensure_jobs/{jobId} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /ai_jobs/{jobId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    function orderStatusUpdateKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'status',
          'updatedAt',
          'rejectionReason',
          'rejectedBy',
          'cancellationReason',
          'statusBeforeCancellation',
          'cancelledAt',
          'deliveredAt',
          'confirmedAt',
          'commissionDeducted',
          'paymentProofUrl',
          'paymentStatus',
          'deletedBy',
          'hiddenBy'
        ]);
    }

    function orderBelongsToCeoCompany() {
      let ceo = currentUser();
      return isCeo()
        && 'companyId' in ceo
        && ceo.companyId is string
        && ceo.companyId.size() > 0
        && 'companyId' in resource.data
        && resource.data.companyId == ceo.companyId
        && request.resource.data.companyId == resource.data.companyId;
    }

    function orderAssignedToSupplier() {
      return signedIn()
        && currentRole() == 'supplier'
        && (
          ('supplierId' in resource.data && resource.data.supplierId == request.auth.uid)
          || ('supplierUid' in resource.data && resource.data.supplierUid == request.auth.uid)
        )
        && request.resource.data.companyId == resource.data.companyId;
    }

    function orderOwnedByFieldUser() {
      return signedIn()
        && currentRole() == 'fielduser'
        && 'fieldUserUid' in resource.data
        && resource.data.fieldUserUid == request.auth.uid
        && request.resource.data.companyId == resource.data.companyId;
    }

    match /orders/{orderId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin()
        || (orderBelongsToCeoCompany() && orderStatusUpdateKeysOnly())
        || (orderAssignedToSupplier() && orderStatusUpdateKeysOnly())
        || (orderOwnedByFieldUser() && orderStatusUpdateKeysOnly());
      allow delete: if isAdmin();
    }

    // Nested company order copies (legacy) — same company/role checks.
    match /companies/{companyId}/orders/{orderId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if isAdmin()
        || (
          isCeo()
          && 'companyId' in currentUser()
          && currentUser().companyId == companyId
          && orderStatusUpdateKeysOnly()
        )
        || (orderAssignedToSupplier() && orderStatusUpdateKeysOnly())
        || (orderOwnedByFieldUser() && orderStatusUpdateKeysOnly());
      allow delete: if isAdmin();
    }

    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && collection != 'users'
        && collection != 'companies'
        && collection != 'orders'
        && collection != 'rfqs'
        && collection != 'disputes'
        && collection != 'audit_logs'
        && collection != 'ai_jobs'
        && collection != 'rfq_jobs'
        && collection != 'dispute_jobs'
        && collection != 'dispute_update_jobs'
        && collection != 'rfq_bid_jobs'
        && collection != 'rfq_award_jobs'
        && collection != 'rfq_cancel_jobs'
        && collection != 'rfq_bid_withdraw_jobs'
        && collection != 'dispute_withdraw_jobs'
        && collection != 'commission_ensure_jobs'
        && collection != 'appeals';
    }
  }
}
